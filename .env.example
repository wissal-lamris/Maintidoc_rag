# Copier ce fichier en ".env" (même dossier). Ne jamais committer le fichier .env.

# Base vectorielle Qdrant (lancée avec Docker : docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_PREFIX=maintidoc
TEXT_COLLECTION=chunks
CLIP_COLLECTION=images_clip

# Modèles d'embeddings open source (Hugging Face)
EMBED_MODEL=BAAI/bge-m3
CLIP_MODEL=clip-ViT-B-32

# Ollama (modèles open source en local)
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
LLM_MODEL=qwen3.5:4b

# Adresse de l'API (utilisée par l'interface)
API_URL=http://127.0.0.1:8000

# Découpage du texte (en tokens)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
